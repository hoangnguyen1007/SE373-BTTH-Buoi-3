# ==============================================================================
# SE373 BUỔI 03 - CẤU HÌNH MÔI TRƯỜNG MẪU (ENV CONFIGURATION TEMPLATE)
# TUYỆT ĐỐI KHÔNG LƯU SECRET KEY THẬT VÀO FILE NÀY HAY COMMIT VÀO GIT REPOSITORY
# Copy file này thành .env và điền cấu hình thực tế khi chạy ở chế độ LIVE.
# ==============================================================================

# Chế độ chạy: "mock" (chạy mô phỏng không tốn tiền API, 100% offline) hoặc "live" (gọi LLM thật)
RUN_MODE=mock

# Mô hình sử dụng (Ví dụ: gpt-4o-mini, gpt-4o)
SE373_MODEL=gpt-4o-mini

# API Keys (Chỉ cần thiết khi RUN_MODE=live)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
